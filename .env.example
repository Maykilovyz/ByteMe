# Copie para .env.local e preencha. NUNCA suba .env.local para o GitHub.
GEMINI_API_KEY=
# Modelos tentados em ordem: se um estiver sobrecarregado (503/429) ou demorar, passa para o próximo.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.8-flash
# Reserva (opcional): usada só se o Gemini der erro de limite (HTTP 429) ou falhar.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Salário mínimo vigente em reais. 2026: R$ 1.621 (decreto publicado no Diário Oficial; ver README).
SALARIO_MINIMO=1621
# Cidades atendidas, separadas por vírgula. Com uma só, a IA não pergunta a cidade.
CIDADES=Ananindeua
# Quem lê a conversa: vazio = a IA, ou o simulador de demonstração quando não há chave; "simulador" = sempre o simulador; "ia" = nunca.
MODO_IA=
# Banco de dados (opcional). Sem estas duas variáveis, os atendimentos ficam num arquivo do computador (data/runtime-db.json).
# Obrigatório para publicar na Vercel. Crie o projeto no Supabase e rode docs/supabase-schema.sql no SQL Editor.
# A chave é a SECRETA (service_role ou sb_secret_...). Nunca use a chave pública aqui e nunca suba este arquivo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
